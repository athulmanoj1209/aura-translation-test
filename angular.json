{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "apollo-ng": {
            "i18n": {
                "sourceLocale": {
                    "code": "en",
                    "baseHref": "/en/"
                },
                "locales": {
                    "es": {
                        "translation": "src/locale/translation.es.xlf",
                        "baseHref": "/es/"
                    },
                    "de": {
                        "translation": "src/locale/translation.de.xlf",
                        "baseHref": "/de/"
                    },
                    "fr": {
                        "translation": "src/locale/translation.fr.xlf",
                        "baseHref": "/fr/"
                    },
                    "ar": {
                        "translation": "src/locale/translation.ar.xlf",
                        "baseHref": "/ar/"
                    }
                }
            },
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": "dist/apollo-ng",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "localize": [
                            "en",
                            "es",
                            "de",
                            "fr",
                            "ar"
                        ],
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "styles": [
                            "src/assets/styles.scss",
                            "src/assets/tailwind.css"
                        ],
                        "scripts": [],
                        "polyfills": [
                            "@angular/localize/init"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1mb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "150kb",
                                    "maximumError": "150kb"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "localize": false
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "apollo-ng:build:production"
                        },
                        "development": {
                            "buildTarget": "apollo-ng:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "outputPath": "src/locale",
                        "outFile": "translation.xlf"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "tsConfig": "tsconfig.spec.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets"
                        ],
                        "styles": [
                            "src/assets/styles.scss"
                        ],
                        "scripts": [],
                        "polyfills": [
                            "@angular/localize/init"
                        ]
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false,
        "cache": {
            "enabled": false
        }
    }
}